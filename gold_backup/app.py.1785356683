from flask import Flask,request,jsonify
from flask_cors import CORS
from flask_jwt_extended import JWTManager,create_access_token,jwt_required
import psycopg2


app=Flask(__name__)
CORS(app)

app.config["JWT_SECRET_KEY"]="MUTEB_SOC_SECRET"
jwt=JWTManager(app)


def db():
    return psycopg2.connect(
        host="localhost",
        database="muteb_soc",
        user="muteb_admin",
        password="MutebDB@2026"
    )


def init():

    c=db()
    x=c.cursor()

    x.execute("""
    CREATE TABLE IF NOT EXISTS users(
    id SERIAL PRIMARY KEY,
    username TEXT,
    password TEXT,
    role TEXT);
    
    CREATE TABLE IF NOT EXISTS alerts(
    id SERIAL PRIMARY KEY,
    title TEXT,
    severity TEXT,
    status TEXT);

    CREATE TABLE IF NOT EXISTS incidents(
    id SERIAL PRIMARY KEY,
    title TEXT,
    status TEXT);

    CREATE TABLE IF NOT EXISTS logs(
    id SERIAL PRIMARY KEY,
    message TEXT);
    """)

    x.execute("""
    INSERT INTO users(username,password,role)
    SELECT 'admin','Muteb@Admin2026','Admin'
    WHERE NOT EXISTS
    (SELECT 1 FROM users WHERE username='admin');
    """)

    c.commit()
    c.close()



@app.route("/api/login",methods=["POST"])
def login():

    d=request.json

    c=db()
    x=c.cursor()

    x.execute(
    "select role from users where username=%s and password=%s",
    (d["username"],d["password"]))

    u=x.fetchone()

    if u:
        return jsonify({
        "success":True,
        "token":create_access_token(identity=d["username"]),
        "role":u[0]
        })

    return jsonify({"success":False}),401



@app.route("/api/dashboard")
@jwt_required(optional=True)
def dashboard():

    return jsonify({
    "critical_alerts":1,
    "open_incidents":1,
    "threat_score":85
    })



@app.route("/api/alerts",methods=["GET","POST"])
def alerts():

    c=db()
    x=c.cursor()

    if request.method=="POST":
        d=request.json
        x.execute(
        "insert into alerts(title,severity,status) values(%s,%s,%s)",
        (d["title"],d["severity"],"Open"))
        c.commit()

    x.execute("select * from alerts")
    return jsonify(x.fetchall())



@app.route("/api/incidents",methods=["GET","POST","PUT"])
def incidents():

    c=db()
    x=c.cursor()

    if request.method=="POST":
        x.execute(
        "insert into incidents(title,status) values(%s,'Open')",
        (request.json["title"],))
        c.commit()

    x.execute("select * from incidents")

    return jsonify(x.fetchall())




@app.route("/api/users")
def users():

    c=db()
    x=c.cursor()

    x.execute("""
    SELECT username,role
    FROM users
    ORDER BY username
    """)

    return jsonify(x.fetchall())



@app.route("/api/users/add",methods=["POST"])
def add_user():

    d=request.json

    c=db()
    x=c.cursor()

    x.execute(
    "INSERT INTO users(username,password,role) VALUES(%s,%s,%s)",
    (d["username"],d["password"],d["role"])
    )

    c.commit()

    return jsonify({"success":True})



@app.route("/api/users/delete/<int:id>",methods=["DELETE"])
def delete_user(id):

    c=db()
    x=c.cursor()

    x.execute(
    "DELETE FROM users WHERE id=%s",
    (id,)
    )

    c.commit()

    return jsonify({"success":True})



@app.route("/")
def home():
    return jsonify({"MUTEB SOC":"ONLINE"})



if __name__=="__main__":

    init()

    app.run(
    host="0.0.0.0",
    port=8000)


@app.route("/api/stats")
def stats():
    c=db()
    x=c.cursor()

    x.execute("SELECT COUNT(*) FROM alerts")
    alerts=x.fetchone()[0]

    x.execute("SELECT COUNT(*) FROM incidents WHERE status!='Closed'")
    incidents=x.fetchone()[0]

    x.execute("SELECT COUNT(*) FROM users")
    users=x.fetchone()[0]

    return jsonify({
        "alerts":alerts,
        "incidents":incidents,
        "users":users,
        "threat_score":85
    })


@app.route("/api/logs")
def logs():
    c=db()
    x=c.cursor()

    x.execute("""
    SELECT *
    FROM logs
    ORDER BY id DESC
    LIMIT 50
    """)

    return jsonify(x.fetchall())



from werkzeug.security import generate_password_hash, check_password_hash


@app.route("/api/users/all")
def users_all():

    c=db()
    x=c.cursor()

    x.execute("""
    SELECT id,username,role
    FROM users
    """)

    return jsonify(x.fetchall())



@app.route("/api/users/change-role/<int:id>",methods=["PUT"])
def change_role(id):

    data=request.json

    role=data.get("role")

    c=db()
    x=c.cursor()

    x.execute("""
    UPDATE users
    SET role=%s
    WHERE id=%s
    """,(role,id))

    c.commit()

    return jsonify({
        "success":True
    })



@app.route("/api/users/password/<int:id>",methods=["PUT"])
def change_password(id):

    data=request.json

    password=data.get("password")

    hashed=generate_password_hash(password)


    c=db()
    x=c.cursor()

    x.execute("""
    UPDATE users
    SET password=%s
    WHERE id=%s
    """,(hashed,id))

    c.commit()


    return jsonify({
        "success":True
    })



@app.route("/api/audit")
def audit():

    c=db()
    x=c.cursor()

    x.execute("""
    SELECT *
    FROM logs
    ORDER BY id DESC
    LIMIT 100
    """)

    return jsonify(x.fetchall())




