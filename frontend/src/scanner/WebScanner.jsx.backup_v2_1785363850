
import React,{useState,useEffect} from "react";

import axios from "axios";



export default function WebScanner(){


const [target,setTarget]=useState("");

const [loading,setLoading]=useState(false);

const [history,setHistory]=useState([]);

const [result,setResult]=useState(null);

const [progress,setProgress]=useState(0);



async function loadHistory(){


try{


const r=await axios.get(

"/api/scanner/v2/history"

);


setHistory(

r.data.history || []

);


}

catch(e){}



}



useEffect(()=>{


loadHistory();


},[]);





async function startScan(){


if(!target){

alert(
"Target required"
);

return;

}



setLoading(true);

setProgress(10);



let timer=setInterval(()=>{


setProgress(
p=>p>=90?p:p+10
);


},500);




try{


const r=await axios.post(

"/api/scanner/v2/start",

{

target:target

}

);



setResult(

r.data

);



setProgress(100);



loadHistory();



}

catch(e){


alert(
"Scanner Error"
);


}


clearInterval(timer);

setLoading(false);


}




return (

<div className="soc-page">


<h1>

🛡️ MUTEB SOC SCANNER v2 ENTERPRISE

</h1>



<div className="soc-card">


<input

className="soc-input"

placeholder="example.com"

value={target}

onChange={
e=>setTarget(e.target.value)
}

/>



<button

className="soc-button"

onClick={startScan}

disabled={loading}

>


{loading?
"SCANNING...":
"START SCAN"
}


</button>



</div>




{

loading &&

<div className="soc-card">

<h3>

SCAN PROGRESS

</h3>


<div>

{progress}%

</div>


</div>


}





{

result &&


<div className="soc-card">


<h2>

TARGET:

{result.target}

</h2>



<h3>

RISK:

{result.risk}

</h3>



<h3>

FINDINGS:

{result.findings?.length || 0}

</h3>




<table>


<thead>

<tr>

<th>OWASP</th>

<th>Severity</th>

<th>Title</th>

</tr>

</thead>



<tbody>


{

(result.findings || []).map(

(f,i)=>(

<tr key={i}>


<td>

{f.owasp || "A05"}

</td>


<td>

{f.severity || "MEDIUM"}

</td>


<td>

{f.title}

</td>


</tr>

)

)

}


</tbody>



</table>



<button

className="soc-button"

onClick={()=>{

window.open(

"/api/scanner/v2/report/"+result.scan_id

)

}}

>


EXPORT PDF REPORT

</button>



</div>


}







<div className="soc-card">


<h2>

SCAN HISTORY

</h2>



<table>


<thead>

<tr>

<th>

Target

</th>

<th>

Risk

</th>

<th>

Findings

</th>

<th>

Date

</th>

</tr>

</thead>



<tbody>


{

history.map(

(item,i)=>(

<tr key={i}>


<td>

{item.target}

</td>


<td>

{item.risk}

</td>


<td>

{item.findings.length}

</td>


<td>

{item.date}

</td>



</tr>

)

)

}


</tbody>



</table>


</div>



</div>


)


}

