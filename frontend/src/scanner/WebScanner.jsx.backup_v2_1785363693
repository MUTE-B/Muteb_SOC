
import React,{useState,useEffect} from "react";

import axios from "axios";

import "../style.css";



export default function WebScanner(){


const [target,setTarget]=useState("");

const [loading,setLoading]=useState(false);

const [progress,setProgress]=useState(0);

const [history,setHistory]=useState([]);

const [result,setResult]=useState(null);



async function loadHistory(){

try{

const r=await axios.get(
"/api/scanner/v2/history"
);


setHistory(
r.data.history || []
);


}catch(e){}

}



useEffect(()=>{

loadHistory();

},[]);




async function startScan(){


if(!target)
return;



setLoading(true);

setProgress(20);



try{


const timer=setInterval(()=>{

setProgress(
p=>p<90?p+10:p
);

},500);



const r=await axios.post(

"/api/scanner/v2/start",

{
target:target
}

);



clearInterval(timer);


setProgress(100);


setResult(
r.data
);


loadHistory();



}catch(e){


alert(
"Scanner Error"
);


}



setLoading(false);



}





async function exportPDF(id){


window.open(

"/api/scanner/v2/report/"+id,

"_blank"

);


}




return (

<div className="soc-page">


<h1>

🛡️ MUTEB SOC Scanner v2 Enterprise

</h1>



<div className="soc-card">


<input

className="soc-input"

placeholder="example.com"

value={target}

onChange={
e=>setTarget(e.target.value)
}

/>



<button

className="soc-button"

onClick={startScan}

>

Start Scan

</button>


</div>




{

loading &&

<div className="soc-card">


<h3>

Scanning...

</h3>


<div>

Progress: {progress}%

</div>


</div>

}




{

result &&

<div className="soc-card">


<h2>

Target:

{result.target}

</h2>


<h3>

Risk:

{result.risk}

</h3>



<table>


<thead>

<tr>

<th>
Finding
</th>

<th>
Severity
</th>

<th>
OWASP
</th>

</tr>

</thead>



<tbody>


{

(result.findings||[]).map(

(f,i)=>(

<tr key={i}>


<td>

{f.title}

</td>


<td>

{f.severity}

</td>


<td>

{f.owasp}

</td>


</tr>

)

)

}


</tbody>


</table>



<button

className="soc-button"

onClick={()=>exportPDF(result.scan_id)}

>

Export PDF Report

</button>


</div>


}




<div className="soc-card">


<h2>

Scan History

</h2>



<table>


<thead>

<tr>

<th>
Target
</th>

<th>
Risk
</th>

<th>
Findings
</th>

<th>
Date
</th>

<th>
Report
</th>

</tr>


</thead>


<tbody>


{

history.map(

(scan,i)=>(


<tr key={i}>


<td>
{scan.target}
</td>


<td>
{scan.risk}
</td>


<td>
{scan.findings?.length || 0}
</td>


<td>
{scan.date}
</td>


<td>


<button

onClick={
()=>exportPDF(scan.scan_id)
}

>

PDF

</button>


</td>


</tr>


)

)

}



</tbody>


</table>


</div>



</div>

)

}

