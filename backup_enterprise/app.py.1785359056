from flask import Flask,request,jsonify
from flask_cors import CORS
from flask_jwt_extended import (
JWTManager,
create_access_token
)

from routes.health import health
from routes.dashboard import dashboard


app=Flask(__name__)

CORS(app)


app.config[
"JWT_SECRET_KEY"
]="MUTEB_SOC_ENTERPRISE_SECRET"


jwt=JWTManager(app)



app.register_blueprint(
health
)

app.register_blueprint(
dashboard
)



@app.route("/api/login",methods=["POST"])
def login():

    data=request.json

    if (
        data.get("username")
        =="admin"
        and
        data.get("password")
        =="Muteb@Admin2026"
    ):

        token=create_access_token(
            identity="admin"
        )


        return jsonify({

            "success":True,

            "role":"Admin",

            "token":token

        })


    return jsonify({

        "success":False

    }),401



@app.route("/")
def index():

    return jsonify({

        "system":
        "MUTEB SOC Enterprise",

        "status":
        "running"

    })



if __name__=="__main__":

    app.run(
        host="0.0.0.0",
        port=8000
    )
