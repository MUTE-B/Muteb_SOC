

from flask import Blueprint,request,jsonify,send_file

from datetime import datetime

import os
import json
import uuid



from modules.web_security_scanner import scan_domain
from modules.pdf_report_engine import create_pdf_report


from integrations.security_hooks import (

send_to_mitre,

send_to_ioc,

send_to_incident

)




scanner_v2_bp = Blueprint(

"scanner_v2",

__name__

)



HISTORY_FILE="logs/scanner_history.json"

REPORT_DIR="reports"



os.makedirs(
REPORT_DIR,
exist_ok=True
)



os.makedirs(
"logs",
exist_ok=True
)



if not os.path.exists(
HISTORY_FILE
):


    with open(
    HISTORY_FILE,
    "w"
    ) as f:

        json.dump(
        [],
        f
        )





def save_history(item):


    with open(
    HISTORY_FILE
    ) as f:

        data=json.load(f)



    data.append(item)



    with open(
    HISTORY_FILE,
    "w"
    ) as f:

        json.dump(
        data,
        f,
        indent=4
        )






@scanner_v2_bp.route(

"/api/scanner/v2/start",

methods=["POST"]

)

def start_scan():


    data=request.get_json() or {}


    target=data.get(
    "target"
    )



    if not target:


        return jsonify({

        "success":False,

        "error":"Target required"

        }),400





    scan_id=str(
    uuid.uuid4()
    )



    result=scan_domain(
    target
    )




    findings=result.get(

    "findings",

    []

    )




    mitre=send_to_mitre(

    result

    )



    ioc=send_to_ioc(

    result

    )



    incident=send_to_incident(

    result

    )




    history={


    "scan_id":scan_id,


    "target":target,


    "risk":result.get(
    "risk",
    "LOW"
    ),



    "findings":findings,


    "date":str(
    datetime.now()
    )



    }



    save_history(
    history
    )

    create_pdf_report(scan_id,history)





    return jsonify({


    "success":True,


    "scan_id":scan_id,


    "target":target,


    "risk":result.get(
    "risk"
    ),



    "findings":findings,



    "mitre":mitre,


    "ioc":ioc,


    "incident":incident



    })








@scanner_v2_bp.route(

"/api/scanner/v2/history",

methods=["GET"]

)

def history():


    with open(
    HISTORY_FILE
    ) as f:

        data=json.load(f)



    return jsonify({

    "history":data

    })









@scanner_v2_bp.route(

"/api/scanner/v2/status/<scan_id>",

methods=["GET"]

)

def status(scan_id):


    return jsonify({


    "scan_id":scan_id,


    "status":"completed",


    "progress":100


    })






@scanner_v2_bp.route(

"/api/scanner/v2/report/<scan_id>",

methods=["GET"]

)

def report(scan_id):


    file=f"{REPORT_DIR}/{scan_id}_report.pdf"



    if os.path.exists(file):


        return send_file(
        file,
        as_attachment=True
        )



    return jsonify({

    "error":"Report not found"

    }),404



